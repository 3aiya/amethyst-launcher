{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Amethyst Launcher",
    "version": "1.0.10",
    "identifier":  "com.amethyst.launcher",
    "build":  {
                  "beforeDevCommand":  "npm run dev:vite",
                  "beforeBuildCommand":  "npm run build:vite",
                  "devUrl":  "http://localhost:5173",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "Amethyst Launcher",
                                    "width":  1280,
                                    "height":  720,
                                    "minWidth":  960,
                                    "minHeight":  600,
                                    "decorations":  false,
                                    "transparent":  true,
                                    "shadow":  false,
                                    "resizable":  true
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "createUpdaterArtifacts":  true,
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ]
               },
    "plugins":  {
                    "updater":  {
                                    "active":  true,
                                    "endpoints":  [
                                                      "https://amethyst-launcher-admin.vercel.app/api/public/latest.json",
                                                      "https://github.com/3aiya/amethyst-launcher/releases/latest/download/latest.json"
                                                  ],
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4NTU0MEIwQkM3QjE1MDYKUldRR0ZYdThzRUJWZUM0VzZRQzk3SXAwMDNPT0xCUTBWSmlobW4rVjRWU3BiSVk4dWhkVklGQUQK"
                                }
                }
}
